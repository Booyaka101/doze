{
  "recipe": {
    "name": "Organize files",
    "description": "Move screenshots, financial documents, and archives to specific folders.",
    "rules": [
      {
        "label": "Screenshots",
        "folder": "Screenshots",
        "when": {
          "extensions": [
            ".png",
            ".jpg",
            ".webp"
          ],
          "name_starts_with": "screenshot"
        }
      },
      {
        "label": "Finance",
        "folder": "Finance",
        "when": {
          "extensions": [
            ".pdf"
          ],
          "name_contains": [
            "invoice",
            "receipt"
          ]
        }
      },
      {
        "label": "Archives",
        "folder": "Archives",
        "when": {
          "extensions": [
            ".zip"
          ]
        }
      }
    ]
  },
  "examples": [
    {
      "name": "screenshot-dashboard.png",
      "expected": "Screenshots"
    },
    {
      "name": "screenshot-plan.txt",
      "expected": "HOLD"
    },
    {
      "name": "holiday.jpg",
      "expected": "HOLD"
    },
    {
      "name": "invoice-october.pdf",
      "expected": "Finance"
    },
    {
      "name": "invoice-notes.txt",
      "expected": "HOLD"
    },
    {
      "name": "readme.pdf",
      "expected": "HOLD"
    },
    {
      "name": "assets.zip",
      "expected": "Archives"
    },
    {
      "name": ".env",
      "expected": "HOLD"
    },
    {
      "name": "cleanup.ps1",
      "expected": "HOLD"
    }
  ],
